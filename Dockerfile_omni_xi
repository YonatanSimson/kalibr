# kalibr with this checkout's changes (OMNI_FIXED_XI.md), layered on the arm64 image built by
# exovision-research/gopro_navigation/run_gopro_kalibr.sh --preflight. Build with
# ./build_omni_xi_image.sh, which packs every source file changed since the upstream base commit
# into changed.tar; catkin then rebuilds only what those files touch (CMakeLists changes re-run cmake).
FROM kalibr_ubuntu2004
ADD changed.tar /catkin_ws/src/kalibr/
RUN cd /catkin_ws && catkin build -j4 --no-status
